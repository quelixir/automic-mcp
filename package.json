{
  "name": "automic-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Automic Registry Platform REST API",
  "type": "module",
  "bin": {
    "automic-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "AGPL-3.0-only",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
